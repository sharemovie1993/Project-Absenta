  DAILY
  WEEKLY
  MONTHLY
}

// Persetujuan pengguna untuk dokumen legal
enum ConsentType {
  TERMS
  PRIVACY
  BIOMETRIC
  BILLING
}

model SystemConfig {
  id        String  @id @default(uuid())
  tenant_id String? // null = konfigurasi global (system)

  // General
  app_name         String? // nama aplikasi yang ditampilkan
  default_language String? @default("id")
  timezone         String? @default("Asia/Jakarta")
  date_format      String? @default("DD/MM/YYYY")

  // Branding (centralized)
  tagline         String? // slogan singkat
  description     String? // deskripsi aplikasi/tenant
  primary_color   String? // warna utama UI
  secondary_color String? // warna sekunder UI
  accent_color    String? // warna aksen
  favicon_url     String? // ikon browser
  logo_url        String? // logo utama aplikasi
  footer_text     String? // teks footer
  support_email   String? // email dukungan tenant
  support_phone   String? // no kontak tenant

  // Company Identity (Global Only - for Invoice Issuer)
  company_legal_name      String? // e.g. PT BARAYA TEKNOLOGI INDONESIA
  company_trade_name      String? // e.g. Baraya Tekno
  company_npwp            String? // e.g. 12.345.678.9-012.345
  company_address         String? // e.g. Jl. Buah Batu No. 123, Bandung
  company_email_billing   String? // e.g. billing@baraya.co.id
  company_phone_billing   String? // e.g. +62 812-3456-7890
  company_bank_name       String? // e.g. BANK MANDIRI
  company_bank_account    String? // e.g. 1234567890
  company_bank_holder     String? // e.g. PT BARAYA TEKNOLOGI INDONESIA
  company_logo_url        String? // e.g. https://.../logo.png
  company_signature_name  String? // e.g. Ahmad Junaedi
  company_signature_title String? // e.g. Finance Director

  // Tax (PKP)
  is_pkp   Boolean @default(false)
  ppn_rate Int     @default(11)

  // Payment Gateway - Stripe
  stripe_enabled Boolean @default(false)
  // DEPRECATED: Moved to .env for security
  // stripe_secret_key        String?
  // stripe_publishable_key   String?
  // stripe_webhook_secret    String?
  // stripe_webhook_url       String?

  // Payment Gateway - Midtrans
  midtrans_enabled     Boolean @default(false)
  // DEPRECATED: Moved to .env for security
  // midtrans_server_key      String?
  // midtrans_client_key      String?
  midtrans_environment String? @default("sandbox") // sandbox/production
  // midtrans_webhook_url     String?

  // Payment Gateway - Xendit
  xendit_enabled Boolean @default(false)
  // DEPRECATED: Moved to .env for security
  // xendit_secret_key        String?
  // xendit_public_key        String?
  // xendit_callback_token    String?
  // xendit_webhook_url       String?

  // Payment Gateway - Tripay
  tripay_enabled Boolean @default(false)

  // Notifications
  notif_email_new_payment          Boolean @default(true)
  notif_email_payment_failed       Boolean @default(true)
  notif_email_subscription_expired Boolean @default(true)
  notif_email_monthly_summary      Boolean @default(false)

  webhook_payment_status       Boolean @default(true)
  webhook_subscription_changes Boolean @default(true)
  webhook_billing_events       Boolean @default(true)

  // Security
  session_timeout_minutes  Int     @default(30)
  two_factor_enabled       Boolean @default(false)
  login_attempt_monitoring Boolean @default(true)

  // System
  backup_frequency              BackupFrequency @default(DAILY)
  log_retention_days            Int             @default(30)
  max_upload_mb                 Int             @default(10)
  api_rate_limit_per_minute     Int             @default(100)
  notification_throttle_seconds Int             @default(30)
  digest_time_daily             String?         @default("06:00")
  digest_time_weekly            String?         @default("18:00")
  digest_weekly_day             Int             @default(0)
  quiet_hours_start             String?         @default("22:00")
  quiet_hours_end               String?         @default("06:00")
  default_attendance_email      Boolean         @default(false)
  default_attendance_wa         Boolean         @default(false)
  default_parent_email          Boolean         @default(false)
  default_parent_wa             Boolean         @default(false)
  default_late_threshold        Int             @default(5)
  default_notap_threshold       Int             @default(5)

  // Parent App Feature Flags (Per Tenant)
  parent_app_enabled                    Boolean @default(true)
  parent_app_dashboard_enabled          Boolean @default(true)
  parent_app_attendance_history_enabled Boolean @default(true)
  parent_app_notifications_enabled      Boolean @default(true)
  parent_app_monthly_recap_enabled      Boolean @default(true)
  parent_app_daily_tracking_enabled     Boolean @default(true)
  parent_app_report_absence_enabled     Boolean @default(true)

  // Audit
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

