generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String      @id @default(uuid())
  name         String
  absensi_mode AbsensiMode @default(SIMPLE)

  // Konfigurasi Absensi Default (Global)
  jam_masuk_default             String @default("07:00") // Format HH:mm
  jam_pulang_default            String @default("14:00") // Format HH:mm
  toleransi_keterlambatan_menit Int    @default(15) // Durasi toleransi dalam menit

  AbsensiKejadianKhusus AbsensiKejadianKhusus[]
  StudentCardConfig     StudentCardConfig?

  domain                  String?                  @unique
  logo_url                String?
  status                  String                   @default("ACTIVE")
  deletion_requested_at   DateTime?
  created_at              DateTime                 @default(now())
  updated_at              DateTime                 @updatedAt
  AbsenGerbangSiswa       AbsenGerbangSiswa[]
  AbsenGuru               AbsenGuru[]
  AbsenSiswa              AbsenSiswa[]
  activityLogs            ActivityLog[]
  billing                 Billing[]
  config                  Config[]
  documents               Document[]               @relation("TenantDocuments")
  documentActivities      DocumentActivity[]       @relation("TenantDocumentActivities")
  financialReports        FinancialReport[]
  guru                    Guru[]
  GuruMapel               GuruMapel[]
  invoices                Invoice[]
  JenisKegiatanMaster     JenisKegiatanMaster[]
  jurusan                 Jurusan[]
  kelas                   Kelas[]
  KelasMapel              KelasMapel[]
  mapel                   Mapel[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference[]
  OrangTua                OrangTua[]
  payments                Payment[]
  sekolah                 Sekolah[]
  Semester                Semester[]
  sesiAbsensi             SesiAbsensi[]
  SesiGerbang             SesiGerbang[]
  siswa                   Siswa[]
  TahunPelajaran          TahunPelajaran[]
  users                   User[]
  subscriptions           Subscription[]           @relation("TenantSubscriptions")
  SystemConfig            SystemConfig[]
  SiswaFaceTemplate       SiswaFaceTemplate[]
  RefundRecord            RefundRecord[]
  JadwalTemplate          JadwalTemplate[]
  PelanggaranSiswa        PelanggaranSiswa[]
  SupervisiGuru           SupervisiGuru[]
  JenisPelanggaran        JenisPelanggaran[]
  SiswaDocument           SiswaDocument[]
  roles                   Role[]
  tenantRiskScore         TenantRiskScore?
  tenantRiskScoreLogs     TenantRiskScoreLog[]
  tenantRiskEvents        TenantRiskEvent[]
  TenantBackup            TenantBackup[]
  Member                  Member[]

  // Koperasi
  SavingCategory SavingCategory[]
  ShuConfig      ShuConfig?
  ShuPeriod      ShuPeriod[]
  ProductCategory ProductCategory[]
  CoopPointTransaction CoopPointTransaction[]

  organizationalPositions   OrganizationalPosition[]
  organizationalAssignments OrganizationalAssignment[]

  // Hubin
  MitraIndustri MitraIndustri[]
  SiswaPkl      SiswaPkl[]
  IzinKeluarSiswa IzinKeluarSiswa[]

  // BK & Prestasi
  JenisPrestasi       JenisPrestasi[]
  PrestasiSiswa       PrestasiSiswa[]
  KonselingSiswa      KonselingSiswa[]
  PemanggilanOrangTua PemanggilanOrangTua[]
  HomeVisit           HomeVisit[]
  AsesmenSiswa        AsesmenSiswa[]
  RujukanKasus        RujukanKasus[]

  // Sarpras
  SarprasCategory    SarprasCategory[]
  SarprasLocation    SarprasLocation[]
  SarprasAsset       SarprasAsset[]
  SarprasLoan        SarprasLoan[]
  SarprasAssetRepair SarprasAssetRepair[]

  // TU
  SuratMasuk        SuratMasuk[]
  SuratKeluar       SuratKeluar[]
  StrukturKurikulum StrukturKurikulum[]
  ProgresMateri     ProgresMateri[]
  AbsensiPkl        AbsensiPkl[]
  AttendanceDevice  AttendanceDevice[]
  SupportTicket     SupportTicket[]
  WhatsappConfig    WhatsappConfig?
}


enum BackupStatus {
  READY
  RESTORED
  PURGED
}

enum RestoreStatus {
  NONE
  IN_PROGRESS
  COMPLETED
  FAILED
}

model TenantBackup {
  id                    String        @id @default(uuid())
  tenant_id             String?
  snapshot_date         DateTime      @default(now())
  file_path             String
  file_size_bytes       BigInt
  checksum_sha256       String
  file_signature        String? // HMAC-SHA256 signature of the checksum
  expires_at            DateTime
  status                BackupStatus  @default(READY)
  restored_at           DateTime?
  restored_to_tenant_id String?
  restore_status        RestoreStatus @default(NONE)
  progress_table        String?

  Tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([expires_at])
}

model StudentCardConfig {
  id        String @id @default(uuid())
  tenant_id String @unique

  // Design Config
  template        String  @default("vertical") // vertical | horizontal
  card_title      String  @default("KARTU PELAJAR")
  header_text     String?
  subheader_text  String?
  primary_color   String  @default("#2563eb")
  secondary_color String  @default("#ffffff")
  logo_url        String?
  school_name     String?
  school_address  String?

  // Header & Footer Config (Dimensions in mm)
  header_height     Float   @default(18)
  header_bg_color   String? // overrides primary_color if set
  header_text_color String  @default("#ffffff")

  footer_height   Float   @default(5)
  footer_bg_color String? // overrides primary_color if set

  // Font Sizes (in pt or px equivalent)
  header_font_size          Float @default(10)
  subheader_font_size       Float @default(8)
  school_name_font_size     Float @default(12)
  school_address_font_size  Float @default(8)
  card_title_font_size      Float @default(14)
  student_name_font_size    Float @default(10)
  student_details_font_size Float @default(8)

  // Toggles
  show_photo  Boolean @default(true)
  show_qrcode Boolean @default(true)

  // Positioning
  photo_x     Float @default(0)
  photo_y     Float @default(0)
  photo_scale Float @default(1)

  qrcode_x     Float @default(0)
  qrcode_y     Float @default(0)
  qrcode_scale Float @default(1)

  data_x Float @default(0)
  data_y Float @default(0)

  // Border Config
  show_border  Boolean @default(false)
  border_color String  @default("#000000")
  border_width Float   @default(1)

  // Print Configuration
  print_paper_size    String  @default("A4")
  print_orientation   String  @default("portrait")
  print_mode          String  @default("multi")
  print_margin_top    Float   @default(10)
  print_margin_bottom Float   @default(10)
  print_margin_left   Float   @default(10)
  print_margin_right  Float   @default(10)
  print_gap_x         Float   @default(5)
  print_gap_y         Float   @default(5)
  print_custom_width  Float?
  print_custom_height Float?
  print_auto_center_x Boolean @default(false)
  print_auto_center_y Boolean @default(false)

  // Element Dimensions (in mm)
  photo_width   Float @default(24)
  photo_height  Float @default(32)
  qrcode_width  Float @default(20)
  qrcode_height Float @default(20)

  // Card Dimensions (in mm)
  card_width  Float @default(85.6)
  card_height Float @default(54)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
}

model JenisPelanggaran {
  id               String   @id @default(uuid())
  tenant_id        String
  kategori         String // Ringan, Sedang, Berat
  nama_pelanggaran String
  poin             Int
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model PelanggaranSiswa {
  id                String   @id @default(uuid())
  tenant_id         String
  siswa_id          String
  siswa_akademik_id String?
  kelas_id          String?
  tanggal           DateTime @db.Date
  jenis_pelanggaran String
  poin              Int      @default(0)
  status            String   @default("BARU") // BARU, PROSES, SELESAI
  keterangan        String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  Tenant        Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa         Siswa          @relation(fields: [siswa_id], references: [id])
  SiswaAkademik SiswaAkademik? @relation(fields: [siswa_akademik_id], references: [id])
  Kelas         Kelas?         @relation(fields: [kelas_id], references: [id])

  @@index([tenant_id])
  @@index([siswa_id])
  @@index([tanggal])
}

model SupervisiGuru {
  id            String   @id @default(uuid())
  tenant_id     String
  guru_id       String
  supervisor_id String?
  tanggal       DateTime @db.Date
  mapel         String?
  kelas         String?
  jam_ke        Int?
  status        String   @default("SCHEDULED") // SCHEDULED, COMPLETED
  catatan       String?
  nilai         Int?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  Tenant     Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Guru       Guru   @relation(fields: [guru_id], references: [id])
  Supervisor Guru?  @relation("Supervisor", fields: [supervisor_id], references: [id])

  @@index([tenant_id])
  @@index([guru_id])
  @@index([tanggal])
}

model Permission {
  id             String   @id // Contoh: "academic.student.view" (Manual ID sesuai Catalog)
  description    String?
  group          String? // Contoh: "academic" (untuk grouping di UI)
  module         String? // Contoh: "Siswa", "Guru" (untuk grouping level 2)
  scope_template Json? // Template scope yang didukung permission ini
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  // Relasi
  rolePermissions            RolePermission[]
  organizationalCapabilities OrganizationalCapability[]

  @@index([group])
}

model Role {
  id          String  @id @default(uuid())
  tenant_id   String? // NULL = Global System Role, Value = Custom Tenant Role
  name        String
  description String?
  is_system   Boolean @default(false) // True = Role bawaan sistem (tidak bisa dihapus sembarangan)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  menuRoles       MenuRole[]
  users           User[]
  rolePermissions RolePermission[]
  jobdesk         RoleJobdesk?

  Tenant Tenant? @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

model RoleJobdesk {
  id          String   @id @default(uuid())
  role_id     String   @unique
  description String?
  tasks       Json?    // Array string daftar tugas konkret
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  Role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)
}

model RolePermission {
  id            String @id @default(uuid())
  role_id       String
  permission_id String

  // POLICY CONDITION / SCOPE
  conditions Json?

  created_at DateTime @default(now())

  // Relasi
  Role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  Permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
}

model User {
  id                        String                     @id @default(uuid())
  tenant_id                 String
  email                     String
  password                  String
  full_name                 String
  no_hp                     String?
  role_id                   String
  status                    String                     @default("ACTIVE")
  last_login                DateTime?
  created_at                DateTime                   @default(now())
  updated_at                DateTime                   @updatedAt
  email_verified            Boolean                    @default(false)
  verification_token        String?
  reset_token               String?
  reset_token_expires       DateTime?                  @db.Timestamptz
  has_completed_onboarding  Boolean                    @default(false)
  ActivityLog               ActivityLog[]
  documentsCreated          Document[]                 @relation("DocumentCreatedBy")
  documentActivities        DocumentActivity[]         @relation("DocumentActivityActorUser")
  documentVersionsCreated   DocumentVersion[]          @relation("DocumentVersionCreatedBy")
  Guru                      Guru?
  Siswa                     Siswa?
  SesiAbsensiCreated        SesiAbsensi[]              @relation("SesiAbsensiCreatedBy")
  Role                      Role                       @relation(fields: [role_id], references: [id])
  notificationPreferences   NotificationPreference[]
  Tenant                    Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  organizationalAssignments OrganizationalAssignment[]

  Member              Member?
  SiswaDocument       SiswaDocument[]
  SarprasLoan         SarprasLoan[] @relation("Peminjam")
  KonselingSiswa      KonselingSiswa[]
  SarprasLoanApproved SarprasLoan[] @relation("Approver")
  createdTickets      SupportTicket[] @relation("TicketCreator")
  assignedTickets     SupportTicket[] @relation("TicketAssignee")
  ticketMessages      SupportTicketMessage[]

  @@unique([tenant_id, email])
  @@index([tenant_id])
  @@index([tenant_id, role_id])
  @@index([tenant_id, last_login])
  @@index([verification_token])
  @@index([reset_token])
}

model OrganizationalPosition {
  id         String   @id @default(uuid())
  tenant_id  String
  code       String
  name       String
  scope_type String
  unit_type  String?
  is_active  Boolean  @default(true)
  order      Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant                Tenant                     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  organizationalCaps    OrganizationalCapability[]
  organizationalAssigns OrganizationalAssignment[]
  jobdesk               PositionJobdesk?

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([code])
}

model PositionJobdesk {
  id          String                 @id @default(uuid())
  position_id String                 @unique
  description String?
  tasks       Json?                  // Array string daftar tugas konkret
  created_at  DateTime               @default(now())
  updated_at  DateTime               @updatedAt

  Position OrganizationalPosition @relation(fields: [position_id], references: [id], onDelete: Cascade)
}

model OrganizationalAssignment {
  id          String    @id @default(uuid())
  tenant_id   String
  position_id String
  user_id     String
  kelas_id    String?
  unit_id     String?
  start_date  DateTime?
  end_date    DateTime?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  Tenant   Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Position OrganizationalPosition @relation(fields: [position_id], references: [id], onDelete: Cascade)
  User     User                   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Kelas    Kelas?                 @relation(fields: [kelas_id], references: [id])
  Unit     Jurusan?               @relation(fields: [unit_id], references: [id])

  @@unique([user_id, position_id, kelas_id])
  @@index([tenant_id])
  @@index([user_id])
  @@index([position_id])
  @@index([kelas_id])
  @@index([unit_id])
}

model OrganizationalCapability {
  id            String   @id @default(uuid())
  position_id   String
  permission_id String
  conditions    Json?
  created_at    DateTime @default(now())

  Position   OrganizationalPosition @relation(fields: [position_id], references: [id], onDelete: Cascade)
  Permission Permission             @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([position_id, permission_id])
  @@index([position_id])
  @@index([permission_id])
}

model Module {
  id          String   @id // e.g. "ABSENSI", "KOPERASI", "ERAPOR"
  name        String
  description String?
  icon        String?  // Nama icon Lucide (misal: "building-2")
  order       Int      @default(0)
  is_active   Boolean  @default(true)
  metadata    Json?

  plans       Plan[]
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Plan {
  id            String      @id @default(uuid())
  code          String      @unique
  service_code  String
  module_id     String?
  name          String
  price_monthly Int
  // Kapasitas dan fitur
  max_user      Int?
  features_json Json?
  absensi_mode  AbsensiMode @default(SIMPLE)

  // Deskripsi dan visibilitas
  description String?
  is_public   Boolean @default(true)

  // Siklus penagihan dan harga alternatif
  billing_period BillingPeriod @default(MONTH)
  price_yearly   Int?
  trial_days     Int           @default(0)

  // Metadata dan penghapusan lunak
  size_label String?     @db.VarChar(50)
  tier       String?     @db.VarChar(50)
  metadata   Json?
  deleted_at DateTime?

  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  currency            String              @default("IDR")
  is_active           Boolean             @default(true)
  subscriptions       Subscription[]
  PlanAddon           PlanAddon[]
  planChangesFrom     PlanChangeRequest[] @relation("PlanChangeFrom")
  planChangesTo       PlanChangeRequest[] @relation("PlanChangeTo")
  Module              Module?             @relation(fields: [module_id], references: [id])

  // Indexes untuk performa query
  @@index([is_active])
  @@index([price_monthly])
  @@index([name])
}

model Subscription {
  id                String             @id @default(uuid())
  tenant_id         String
  plan_id           String
  service_code      String
  start_date        DateTime           @db.Timestamptz
  end_date          DateTime           @db.Timestamptz
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt
  auto_renew        Boolean            @default(true)
  next_billing_date DateTime?          @db.Timestamptz
  cancel_date       DateTime?          @db.Timestamptz
  canceled_by       String?
  payment_method    String?
  renewal_count     Int                @default(0)
  notes             String?
  expired_reason    String? // Reason why subscription expired: NON_PAYMENT, MANUAL, TRIAL_END
  status            SubscriptionStatus @default(ACTIVE)

  // Phase 2: Idempotency
  last_applied_invoice_id String? // Tracks the last invoice ID that successfully extended this subscription

  // Enterprise Snapshot (Patch B)
  price_snapshot Int? // Harga deal/kontrak (overrides Plan price)
  pricing_model  String? // TIERED / ACTIVE / DEDICATED
  pricing_meta   Json? // Detail simulasi: students, desc, etc
  plan_snapshot  Json? // Full snapshot of the plan at the time of subscription (features, limits, etc.)

  Billing           Billing[]
  Plan              Plan                  @relation(fields: [plan_id], references: [id])
  Tenant            Tenant                @relation("TenantSubscriptions", fields: [tenant_id], references: [id], onDelete: Cascade)
  History           SubscriptionHistory[]
  Invoice           Invoice[]
  PlanChangeRequest PlanChangeRequest[]
  SubscriptionAddon SubscriptionAddon[]

  @@index([tenant_id])
}

// Enum untuk periodisasi penagihan
enum BillingPeriod {
  MONTH
  YEAR
}

// Tabel fitur terstruktur untuk skalabilitas
model Addon {
  id                String              @id @default(uuid())
  code              String              @unique
  name              String
  price_monthly     Int
  price_yearly      Int?
  service_code      String
  metadata          Json?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  PlanAddon         PlanAddon[]
  SubscriptionAddon SubscriptionAddon[]

  @@index([service_code])
}

model PlanAddon {
  plan_id  String
  addon_id String
  Plan     Plan   @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  Addon    Addon  @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@id([plan_id, addon_id])
  @@index([plan_id])
  @@index([addon_id])
}

model SubscriptionAddon {
  id              String       @id @default(uuid())
  subscription_id String
  addon_id        String
  quantity        Int          @default(1)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  Subscription    Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  Addon           Addon        @relation(fields: [addon_id], references: [id], onDelete: Cascade)

  @@unique([subscription_id, addon_id])
  @@index([subscription_id])
  @@index([addon_id])
}

model Billing {
  id                       String        @id @default(uuid())
  tenant_id                String
  subscription_id          String
  amount                   Int
  charge_type              ChargeType    @default(RECURRING)
  status                   BillingStatus @default(UNPAID)
  created_at               DateTime      @default(now())
  updated_at               DateTime      @updatedAt
  payment_method           String?
  payment_reference        String?
  billing_date             DateTime      @db.Timestamptz
  upgrade_plan_id_snapshot String?
  upgrade_price_snapshot   Int?
  plan_change_request_id   String?
  Subscription             Subscription  @relation(fields: [subscription_id], references: [id])
  Tenant                   Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Invoice                  Invoice?
  Payment                  Payment[]

  @@unique([subscription_id, billing_date])
  @@index([tenant_id, created_at])
}

model Invoice {
  id               String        @id @default(uuid())
  tenant_id        String
  billing_id       String        @unique
  subscription_id  String
  invoice_number   String        @unique
  title            String?
  description      String?
  amount           Int
  // New tax fields
  subtotal_amount  Int           @default(0)
  tax_rate         Float?
  tax_amount       Int?
  total_amount     Int
  tax_type         String?
  tax_included     Boolean       @default(false)
  tax_label        String?
  currency         String        @default("IDR")
  status           InvoiceStatus @default(DRAFT)
  issue_date       DateTime      @default(now()) @db.Timestamptz
  due_date         DateTime      @db.Timestamptz
  period_start     DateTime?     @db.Timestamptz
  period_end       DateTime?     @db.Timestamptz
  sent_at          DateTime?
  viewed_at        DateTime?
  paid_at          DateTime?     @db.Timestamptz
  invoice_items    Json?
  notes            String?
  terms_conditions String?

  // Snapshot Tenant Identity (Audit Safe)
  invoice_tenant_name       String?
  invoice_tenant_identifier String?
  invoice_tenant_address    String?

  // Snapshot Issuer Identity (Audit & Legal Safe)
  invoice_company_legal_name      String?
  invoice_company_trade_name      String?
  invoice_company_npwp            String?
  invoice_company_address         String?
  invoice_company_email_billing   String?
  invoice_company_phone_billing   String?
  invoice_company_logo_url        String?
  invoice_company_signature_name  String?
  invoice_company_signature_title String?

  pdf_path             String?
  pdf_storage_provider String?
  pdf_storage_key      String?
  pdf_sha256           String?
  pdf_generated_at     DateTime?      @db.Timestamptz
  pdf_size_bytes       Int?
  email_sent           Boolean        @default(false)
  whatsapp_sent        Boolean        @default(false)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt
  Billing              Billing        @relation(fields: [billing_id], references: [id])
  Tenant               Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Subscription         Subscription   @relation(fields: [subscription_id], references: [id])
  payments             Payment[]      @relation("InvoicePayments")
  RefundRecord         RefundRecord[]

  @@index([tenant_id, created_at])
  @@index([billing_id])
  @@index([subscription_id])
  @@index([status])
}

// Persisted public invoice tokens to avoid dependency on Redis availability
model InvoicePublicToken {
  id         String    @id @default(uuid())
  invoice_id String
  tenant_id  String?
  token_hash String    @unique
  created_at DateTime  @default(now())
  expires_at DateTime?
  revoked_at DateTime?

  @@index([invoice_id])
  @@index([tenant_id])
}

// Tax type enum
enum TaxType {
  NONE
  PPN
}

model Payment {
  id                     String         @id @default(uuid())
  tenant_id              String
  billing_id             String
  gateway                PaymentGateway
  payment_method         PaymentMethod
  amount                 Int
  currency               String         @default("IDR")
  status                 PaymentStatus  @default(PENDING)
  gateway_transaction_id String?        @unique
  gateway_payment_url    String?
  gateway_qr_string      String?
  gateway_response       Json?
