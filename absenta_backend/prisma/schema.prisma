// SiswaAkademik (Registrasi Siswa)
// Tabel ini berfungsi untuk mendata registrasi siswa pada setiap Semester dan Tahun Pelajaran.
// Ini adalah "pintu masuk" utama bagi siswa agar dapat muncul di fitur Absensi, Nilai, dll.
// Di UI modul Akademik, fitur ini dikenal dengan nama "Registrasi Siswa".
model SiswaAkademik {
  id                 String         @id @default(uuid())
  siswa_id           String
  kelas_id           String
  tahun_pelajaran_id String
  semester_id        String
  status             AkademikStatus @default(AKTIF)

  siswa          Siswa          @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  kelas          Kelas          @relation(fields: [kelas_id], references: [id], onDelete: Cascade)
  tahunPelajaran TahunPelajaran @relation(fields: [tahun_pelajaran_id], references: [id], onDelete: Cascade)
  semester       Semester       @relation(fields: [semester_id], references: [id], onDelete: Cascade)
  AbsenSiswa      AbsenSiswa[]
  PelanggaranSiswa PelanggaranSiswa[]
  SiswaPkl         SiswaPkl[]
  IzinKeluarSiswa  IzinKeluarSiswa[]
  PrestasiSiswa    PrestasiSiswa[]

  @@unique([siswa_id, tahun_pelajaran_id, semester_id])
}

