  jam_selesai String // Format "HH:mm" (24-hour)

  // Konten
  mapel_id       String? // Nullable (misal untuk istirahat/upacara)
  guru_id        String? // Nullable
  jenis_kegiatan String  @default("KBM") // Mapping ke SesiAbsensi.jenis_kegiatan

  // Metadata
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  created_by_user_id String?

  // Relations
  Tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  TahunPelajaran TahunPelajaran @relation(fields: [tahun_pelajaran_id], references: [id])
  Semester       Semester       @relation(fields: [semester_id], references: [id])
  Kelas          Kelas          @relation(fields: [kelas_id], references: [id])
  Mapel          Mapel?         @relation(fields: [mapel_id], references: [id])
  Guru           Guru?          @relation(fields: [guru_id], references: [id])

  // Relation ke Instance Sesi (One-to-Many)
  SesiAbsensi SesiAbsensi[]

  // Constraint 1: Satu kelas tidak boleh punya dua kegiatan di slot waktu yang sama persis
  @@unique([kelas_id, tahun_pelajaran_id, semester_id, hari, jam_mulai, jam_selesai])
  // Constraint 2: Satu guru tidak boleh mengajar di dua tempat di slot waktu yang sama persis
  @@unique([guru_id, tahun_pelajaran_id, semester_id, hari, jam_mulai, jam_selesai])
  // Indexes & Constraints
  @@index([tenant_id, tahun_pelajaran_id, semester_id])
  @@index([kelas_id, hari])
  @@index([guru_id, hari])
}

model StrukturKurikulum {
  id                 String   @id @default(uuid())
  tenant_id          String
  mapel_id           String
  tahun_pelajaran_id String
  tingkat            Int
  jurusan_id         String?
  jp_per_minggu      Int      @default(2)
  kelompok           String? // Nasional, Kejuruan, Pilihan
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  Tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  TahunPelajaran TahunPelajaran @relation(fields: [tahun_pelajaran_id], references: [id])
  Mapel          Mapel          @relation(fields: [mapel_id], references: [id])
  Jurusan        Jurusan?       @relation(fields: [jurusan_id], references: [id])

  @@index([tenant_id])
}

model ProgresMateri {
  id                String   @id @default(uuid())
  tenant_id         String
  sesi_id           String   @unique
  judul_materi      String
  deskripsi         String?  @db.Text
  pencapaian_persen Int      @default(0)
  kendala           String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  Tenant      Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  SesiAbsensi SesiAbsensi @relation(fields: [sesi_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model AbsensiKejadianKhusus {
  id        String @id @default(uuid())
  tenant_id String
  Tenant    Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  tanggal    DateTime @db.Date
  keterangan String // Contoh: "Hujan Deras Pagi Hari"

  // Jika true, semua absensi hari ini dianggap tidak terlambat
  abaikan_terlambat Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([tenant_id, tanggal])
  @@map("absensi_kejadian_khusus")
}

model ParentPushSubscription {
  id           String   @id @default(uuid())
  orang_tua_id String
  endpoint     String   @unique
  keys_json    Json // Store { p256dh, auth }
  user_agent   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  OrangTua OrangTua @relation(fields: [orang_tua_id], references: [id], onDelete: Cascade)

  @@index([orang_tua_id])
}

// Deleted duplicate models definitions (moved to top near Role)
// --- KOPERASI MODULE SCHEMA (PARTIAL) ---
// Copy content below to Absenta main schema.prisma

// --- DATA MASTER (ANGGOTA) ---
model Member {
  id       String @id @default(uuid())
  tenantId String // Foreign Key ke Tenant (di Absenta)

  // Relasi ke Core (Salah satu harus terisi)
  siswaId String? @unique
  guruId  String? @unique
  userId  String? @unique // Untuk login dashboard member

  memberNo String
  type     MemberType   @default(STUDENT)
  status   MemberStatus @default(ACTIVE)
  pin      String?      // Hash PIN 6-digit untuk otorisasi pembayaran cashless
  points   Int          @default(0)

  // Relasi Database
  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Siswa  Siswa? @relation(fields: [siswaId], references: [id], onDelete: Cascade)
  Guru   Guru?  @relation(fields: [guruId], references: [id], onDelete: Cascade)
  User   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  savings           Saving[]
  loans             Loan[]
  sales             Sale[]
  tickets           Ticket[]
  shuAllocations    ShuAllocation[]
  vouchers          Voucher[]
  pointTransactions CoopPointTransaction[]

  joinDate  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, memberNo])
  @@index([tenantId])
}

enum MemberType {
  STUDENT
  TEACHER
  STAFF
  GENERAL
}

// --- MASTER JENIS SIMPANAN (menggantikan SavingType enum) ---
model SavingCategory {
  id          String   @id @default(uuid())
  tenantId    String
  code        String   // 'POKOK', 'WAJIB', 'SUKARELA', 'SHR', atau custom
  name        String   // "Simpanan Hari Raya", "Simpanan Wajib", dll
  description String?
  color       String?  // hex color untuk badge UI
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  // Aturan bisnis per kategori
  isMandatory    Boolean  @default(false) // Wajib setor tiap bulan?
  isWithdrawable Boolean  @default(true)  // Bisa ditarik?
  withdrawRule   String?  // 'ANYTIME'|'RESIGN_ONLY'|'YEAR_END'|'HOLIDAY'
  defaultAmount  Decimal? // Nominal default setoran (untuk UI autofill)

  // Konfigurasi SHU
  isIncludedInShu Boolean @default(false) // Dihitung dalam jasa modal SHU?

  // Kode akun untuk double-entry journal
  accountCode String @default("2010")

  Tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Savings Saving[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// --- SIMPANAN ---
model Saving {
  id         String  @id @default(uuid())
  categoryId String
  amount     Decimal @default(0)

  memberId String
  member   Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category SavingCategory @relation(fields: [categoryId], references: [id])

  transactions SavingTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, categoryId])
  @@index([memberId])
  @@index([categoryId])
}

model SavingTransaction {
  id          String          @id @default(uuid())
  amount      Decimal
  type        TransactionType
  date        DateTime        @default(now())
  description String?

  savingId String
  saving   Saving @relation(fields: [savingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- PINJAMAN ---
model Loan {
  id           String     @id @default(uuid())
  amount       Decimal
  interestRate Decimal
  duration     Int
  status       LoanStatus @default(PENDING)

  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  installments Installment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Installment {
  id       String            @id @default(uuid())
  amount   Decimal
  dueDate  DateTime
  paidDate DateTime?
  status   InstallmentStatus @default(UNPAID)

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- PEMBUKUAN (ACCOUNTING) ---
model Account {
  id   String      @id @default(uuid())
  code String
  name String
  type AccountType

  tenantId String

  journalItems JournalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Journal {
  id          String   @id @default(uuid())
  tenantId    String?
  date        DateTime
  description String?
  reference   String?

  items JournalItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model JournalItem {
  id     String      @id @default(uuid())
  amount Decimal
  type   JournalType

  journalId String
  journal   Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// --- TOKO / PERDAGANGAN ---
model Product {
  id        String  @id @default(uuid())
  code      String
  name      String
  price     Decimal
  costPrice Decimal @default(0)
  stock     Int     @default(0)
  category  String?

  tenantId String

  saleItems    SaleItem[]
  stockInItems CoopStockInItem[]
  stockOpnameItems CoopStockOpnameItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String
  code        String   // 'MAKANAN', 'MINUMAN', dll.
  name        String   // 'Makanan', 'Minuman', dll.
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@unique([tenantId, name])
}

model CoopStockIn {
  id            String            @id @default(uuid())
  tenantId      String
  date          DateTime          @default(now())
  supplier      String?           // Nama vendor / supplier penyedia barang
  notes         String?           // Catatan penjelas tambahan
  paymentMethod String            @default("CASH") // "CASH" | "CREDIT"
  operatorId    String?           // User ID admin / operator yang menginput barang masuk
  shippingFee   Decimal           @default(0) // Ongkos kirim (dicatat sebagai beban operasional terpisah)

  items         CoopStockInItem[]

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model CoopStockInItem {
  id         String   @id @default(uuid())
  stockInId  String
  productId  String
  quantity   Int
  costPrice  Decimal  // Harga modal beli barang saat masuk

  StockIn    CoopStockIn @relation(fields: [stockInId], references: [id], onDelete: Cascade)
  Product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CoopStockOpname {
  id           String   @id @default(uuid())
  tenantId     String
  opnameNumber String
  date         DateTime @default(now())
  status       String   @default("DRAFT") // "DRAFT" | "COMPLETED" | "CANCELLED"
  notes        String?
  operatorId   String?

  items        CoopStockOpnameItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, opnameNumber])
}

model CoopStockOpnameItem {
  id            String          @id @default(uuid())
  opnameId      String
  productId     String
  systemStock   Int
  physicalStock Int
  difference    Int
  costPrice     Decimal
  notes         String?

  Opname        CoopStockOpname @relation(fields: [opnameId], references: [id], onDelete: Cascade)
  Product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String   @id @default(uuid())
  date          DateTime @default(now())
  total         Decimal
  tenantId      String
  paymentMethod String   @default("CASH") // "CASH" | "SAVING"
  cashAmount    Decimal?
  changeAmount  Decimal?
  discount      Decimal? @default(0)
  voucherCode   String?

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id       String  @id @default(uuid())
  quantity Int
  price    Decimal

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// --- FITUR TAMBAHAN ---
model Announcement {
  id       String  @id @default(uuid())
  title    String
  content  String
  isActive Boolean @default(true)

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Voucher {
  id          String    @id @default(uuid())
  code        String
  description String?
  discount    Decimal
  validUntil  DateTime?
  isActive    Boolean   @default(true)

  memberId String?
  Member   Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CoopPointTransaction {
  id          String          @id @default(uuid())
  tenantId    String
  memberId    String
  amount      Int             // Positif untuk perolehan (earn), negatif untuk penukaran (redeem)
  type        CoopPointTxType
  description String?
  referenceId String?         // ID relasi (Sale ID, SavingTransaction ID, atau Voucher ID)
  createdAt   DateTime        @default(now())

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([memberId])
}

enum CoopPointTxType {
  EARN_SHOPPING
  EARN_SAVING
  REDEEM_VOUCHER
}

model Ticket {
  id       String         @id @default(uuid())
  subject  String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  tenantId String

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TicketMessage {
  id      String  @id @default(uuid())
  content String
  isStaff Boolean @default(false)

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PPOBProduct {
  id       String   @id @default(uuid())
  code     String
  name     String
  provider String
  type     PPOBType
  price    Decimal
  fee      Decimal  @default(0)
  isActive Boolean  @default(true)

  tenantId String

  transactions PPOBTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PPOBTransaction {
  id         String     @id @default(uuid())
  customerNo String
  amount     Decimal
  status     PPOBStatus @default(PENDING)

  productId String
  product   PPOBProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  tenantId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- ENUMS (Ensure no conflict with Absenta) ---
enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

// SavingType enum DIHAPUS — digantikan oleh model SavingCategory (dinamis per tenant)

// --- KONFIGURASI SHU PER TENANT ---
model ShuConfig {
  id       String @id @default(uuid())
  tenantId String @unique

  // Persentase alokasi SHU (total harus = 100%)
  porsiJasaModal     Decimal @default(30)
  porsiJasaTransaksi Decimal @default(30)
  porsiCadangan      Decimal @default(20)
  porsiPengurus      Decimal @default(5)
  porsiSosial        Decimal @default(5)
  porsiPembangunan   Decimal @default(10)

  Tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// --- PERIODE SHU PER TAHUN BUKU ---
model ShuPeriod {
  id        String    @id @default(uuid())
  tenantId  String
  year      Int
  startDate DateTime
  endDate   DateTime

  totalRevenue Decimal   @default(0)
  totalExpense Decimal   @default(0)
  totalShu     Decimal   @default(0)

  status     ShuStatus @default(DRAFT)
  approvedBy String?
  approvedAt DateTime?
  notes      String?

  Tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Allocations ShuAllocation[]

  @@unique([tenantId, year])
  @@index([tenantId])
}

// --- ALOKASI SHU PER ANGGOTA PER PERIODE ---
model ShuAllocation {
  id       String @id @default(uuid())
  periodId String
  memberId String

  // Data kalkulasi (audit trail)
  totalSimpananModal Decimal @default(0)
  totalTransaksi     Decimal @default(0)

  jasaModal     Decimal @default(0)
  jasaTransaksi Decimal @default(0)
  totalShu      Decimal @default(0)

  status        ShuAllocationStatus @default(PENDING)
  distributedAt DateTime?
  distributedTo String? // 'SAVINGS' | 'CASH'

  Period ShuPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  Member Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([periodId, memberId])
  @@index([periodId])
  @@index([memberId])
}

enum ShuStatus {
  DRAFT
  CALCULATED
  APPROVED
  DISTRIBUTED
}

enum ShuAllocationStatus {
  PENDING
  DISTRIBUTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INTEREST
  ADMIN_FEE
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  BAD_DEBT
}

enum InstallmentStatus {
  UNPAID
  PENDING
  PAID
  LATE
  FAILED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalType {
  DEBIT
  CREDIT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum PPOBType {
  PULSA
  DATA
  PLN
  PDAM
  OTHER
}

enum PPOBStatus {
  PENDING
  SUCCESS
  FAILED
}

// --- MODUL HUBIN (PKL) ---
model MitraIndustri {
  id         String   @id @default(uuid())
  tenant_id  String
  nama       String
  bidang     String?
  alamat     String?
  kontak     String?
  mou_url    String?
  latitude   Float?
  longitude  Float?
  radius     Int?     @default(100)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant   Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  SiswaPkl SiswaPkl[]

  @@index([tenant_id])
}

model SiswaPkl {
  id              String    @id @default(uuid())
  tenant_id       String
  siswa_id          String
  siswa_akademik_id String?
  mitra_id          String
  tanggal_mulai   DateTime
  tanggal_selesai DateTime?
  status          String    @default("AKTIF") // AKTIF, SELESAI, BATAL
  pembimbing_id   String? // Guru pembimbing
  
  // Geofencing Override (Untuk Branch Office / Lokasi Khusus per Siswa)
  lat_override    Float?
  lon_override    Float?
  radius_override Int?
  is_flexible_location Boolean @default(false) // Jika true, siswa bisa absen di luar radius tapi perlu verifikasi

  nilai_json      Json?
  kunjungan_json  Json?
  jurnal_json     Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  Tenant     Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa         Siswa          @relation(fields: [siswa_id], references: [id], onDelete: Cascade)
  SiswaAkademik SiswaAkademik? @relation(fields: [siswa_akademik_id], references: [id])
  Mitra         MitraIndustri @relation(fields: [mitra_id], references: [id], onDelete: Cascade)
  Pembimbing Guru?         @relation(fields: [pembimbing_id], references: [id])
  AbsensiPkl AbsensiPkl[]

  @@index([tenant_id])
  @@index([siswa_id])
  @@index([mitra_id])
}

model AbsensiPkl {
  id              String   @id @default(uuid())
  tenant_id       String
  siswa_pkl_id    String
  tanggal         DateTime @db.Date
  jam_masuk       DateTime? @db.Timestamptz
  jam_pulang      DateTime? @db.Timestamptz
  status          String   @default("HADIR") // HADIR, IZIN, SAKIT, ALPA
  kegiatan        String?  @db.Text
  image_url       String?
  image_url_out   String?
  
  // Geolocation Data
  latitude_masuk  Float?
  longitude_masuk Float?
  latitude_pulang Float?
  longitude_pulang Float?
  
  // Geofencing Status
  is_outside_radius Boolean @default(false) // Menandai jika absen dilakukan di luar zona (Dinas Luar)
  distance_meters   Int?     // Jarak dalam meter dari lokasi mitra saat absen
  address_snapshot  String? @db.Text // Snapshot alamat saat absen luar zona

  is_verified     Boolean  @default(false)
  verified_by     String?
  verifikasi_at   DateTime?

  SiswaPkl SiswaPkl @relation(fields: [siswa_pkl_id], references: [id], onDelete: Cascade)
  Tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([siswa_pkl_id])
  @@index([tanggal])
}

model IzinKeluarSiswa {
  id                String   @id @default(uuid())
  tenant_id         String
  siswa_akademik_id String
  guru_piket_id     String?
  jam_keluar        DateTime @db.Timestamptz
  jam_kembali       DateTime? @db.Timestamptz
  alasan            String
  tipe_izin         String   @default("IZIN_KELUAR") // IZIN_KELUAR, PULANG_AWAL, IZIN_JURUSAN
  status            String   @default("DISETUJUI") // DISETUJUI, KEMBALI, TERLAMBAT
  created_at        DateTime @default(now()) @db.Timestamptz
  updated_at        DateTime @updatedAt @db.Timestamptz

  Tenant        Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  SiswaAkademik SiswaAkademik @relation(fields: [siswa_akademik_id], references: [id], onDelete: Cascade)
  GuruPiket     Guru?         @relation(fields: [guru_piket_id], references: [id])

  @@index([tenant_id])
  @@index([siswa_akademik_id])
}

// --- MODUL SARPRAS (INVENTORY) ---
model SarprasCategory {
  id         String   @id @default(uuid())
  tenant_id  String
  nama       String
  deskripsi  String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Assets SarprasAsset[]

  @@unique([tenant_id, nama])
  @@index([tenant_id])
}

model SarprasLocation {
  id         String   @id @default(uuid())
  tenant_id  String
  nama       String
  deskripsi  String?
  unit_id    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Assets SarprasAsset[]
  Unit   Jurusan?       @relation(fields: [unit_id], references: [id], onDelete: SetNull)

  @@unique([tenant_id, nama])
  @@index([tenant_id])
}

model SarprasAsset {
  id             String    @id @default(uuid())
  tenant_id      String
  category_id    String?
  location_id    String?
  nama           String
  brand          String?
  serial_number  String?
  kode           String?   @unique
  kondisi        String    @default("BAIK") // BAIK, RUSAK, PERBAIKAN, HILANG
  jumlah         Int       @default(1)
  is_loanable    Boolean   @default(true)
  purchase_date  DateTime?
  price_purchase Decimal?  @db.Decimal(15, 2)
  image_url      String?
  deskripsi      String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant   Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Category SarprasCategory?     @relation(fields: [category_id], references: [id], onDelete: SetNull)
  Location SarprasLocation?     @relation(fields: [location_id], references: [id], onDelete: SetNull)
  Loans    SarprasLoan[]
  Repairs  SarprasAssetRepair[]

  @@index([tenant_id])
  @@index([category_id])
  @@index([location_id])
  @@index([kode])
}

model SarprasLoan {
  id                   String    @id @default(uuid())
  tenant_id            String
  asset_id             String
  peminjam_id          String
  approver_id          String?
  tanggal_pinjam       DateTime  @default(now())
  tanggal_kembali_plan DateTime?
  actual_return_date   DateTime?
  status               String    @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE (DIPINJAM), RETURNED, OVERDUE
  condition_on_return  String?
  catatan              String?
  return_catatan       String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant   Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Asset    SarprasAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)
  Peminjam User         @relation(name: "Peminjam", fields: [peminjam_id], references: [id], onDelete: Cascade)
  Approver User?        @relation(name: "Approver", fields: [approver_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([asset_id])
  @@index([peminjam_id])
  @@index([status])
}

model SarprasAssetRepair {
  id              String    @id @default(uuid())
  tenant_id       String
  asset_id        String
  tanggal_mulai   DateTime  @default(now())
  tanggal_selesai DateTime?
  biaya           Decimal?  @db.Decimal(15, 2)
  teknisi         String?
  deskripsi       String?
  status          String    @default("PROSES") // PROSES, SELESAI, BATAL

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Asset  SarprasAsset @relation(fields: [asset_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([asset_id])
}

// --- MODUL TU (TATA USAHA) ---
model SuratMasuk {
  id             String   @id @default(uuid())
  tenant_id      String
  nomor_surat    String
  judul          String
  asal_surat     String?
  tanggal_surat  DateTime
  tanggal_terima DateTime @default(now())
  dokumen_url    String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model SuratKeluar {
  id            String   @id @default(uuid())
  tenant_id     String
  nomor_surat   String
  judul         String
  tujuan_surat  String?
  tanggal_surat DateTime @default(now())
  dokumen_url   String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model AttendanceDevice {
  id               String   @id @default(uuid())
  tenant_id        String
  device_id        String   @unique // ID Hardware (MAC/ChipID)
  name             String?  // Nama/Alias Alat
  kelas_id         String?  @unique // Link 1:1 ke Kelas
  status           String   @default("INACTIVE") // ONLINE, OFFLINE, INACTIVE
  heartbeat_at     DateTime? @db.Timestamptz
  battery_level    Int?
  firmware_version String?
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @updatedAt @db.Timestamptz

  Kelas            Kelas?   @relation(fields: [kelas_id], references: [id])
  Tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model WhatsappConfig {
  id            String   @id @default(uuid())
  tenant_id     String   @unique
  provider_name String   @default("FONNTE") // e.g., FONNTE, WOWA, CUSTOM
  api_url       String   // Gateway API Endpoint
  api_token     String   // API Key / Token
  sender_number String?  // Nomor pengirim (referensi)
  is_active     Boolean  @default(true)

  // Message Templates (Markdown/Plaintext with placeholders)
  template_absen_masuk  String? @db.Text
  template_absen_pulang String? @db.Text
  template_absen_mapel  String? @db.Text
  template_izin         String? @db.Text
  template_tagihan_spp  String? @db.Text
  template_pengumuman   String? @db.Text

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// ==========================================
// 🎫 SUPPORT TICKETING MODULE MODELS
// ==========================================

enum SupportTicketCategory {
  BILLING
  TECHNICAL
  DEVICE_HARDWARE
  FEATURE_REQUEST
  OTHER
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketSenderType {
  CUSTOMER
  SUPPORT
}

model SupportTicket {
  id             String                @id @default(uuid())
  ticket_number  String                @unique
  tenant_id      String
  creator_id     String
  assigned_to_id String?
  title          String
  description    String                @db.Text
  category       SupportTicketCategory @default(TECHNICAL)
  priority       SupportTicketPriority @default(MEDIUM)
  status         SupportTicketStatus   @default(OPEN)
  rating         Int?
  rating_comment String?               @db.Text
  rated_at       DateTime?
  created_at     DateTime              @default(now())
  updated_at     DateTime              @updatedAt

  Tenant   Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Creator  User                   @relation("TicketCreator", fields: [creator_id], references: [id])
  Assignee User?                  @relation("TicketAssignee", fields: [assigned_to_id], references: [id])
  Messages SupportTicketMessage[]

  @@index([tenant_id])
  @@index([status])
  @@index([priority])
}

model SupportTicketMessage {
  id          String                  @id @default(uuid())
  ticket_id   String
  sender_id   String
  sender_type SupportTicketSenderType
  message     String                  @db.Text
  attachments String[]
  is_internal Boolean                 @default(false)
  created_at  DateTime                @default(now())

  Ticket SupportTicket @relation(fields: [ticket_id], references: [id], onDelete: Cascade)
  Sender User          @relation(fields: [sender_id], references: [id])

  @@index([ticket_id])
}

model SupportQuickReply {
  id         String   @id @default(uuid())
  shortcut   String   @unique
  title      String
  content    String   @db.Text
  category   String   @default("TECHNICAL")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model SupportKnowledgeBase {
  id         String   @id @default(uuid())
  title      String
  content    String   @db.Text
  tags       String[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// Kategori/Jenis Prestasi yang tersedia
model JenisPrestasi {
  id             String           @id @default(uuid())
  tenant_id      String
  kategori       String           // Akademik, Non-Akademik, Sikap/Karakter
  nama_prestasi  String
  poin           Int              // Poin penghargaan (contoh: +10, +25)
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  
  Tenant         Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  PrestasiSiswa  PrestasiSiswa[]

  @@index([tenant_id])
}

// Catatan Prestasi yang diraih Siswa
model PrestasiSiswa {
  id                String         @id @default(uuid())
  tenant_id         String
  siswa_id          String
  siswa_akademik_id String?
  kelas_id          String?
  tanggal           DateTime       @db.Date
  jenis_prestasi_id String?
  nama_prestasi     String         // Menyimpan nama prestasi (atau override)
  poin              Int            @default(0)
  keterangan        String?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  Tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa             Siswa          @relation(fields: [siswa_id], references: [id])
  SiswaAkademik     SiswaAkademik? @relation(fields: [siswa_akademik_id], references: [id])
  Kelas             Kelas?         @relation(fields: [kelas_id], references: [id])
  Jenis             JenisPrestasi? @relation(fields: [jenis_prestasi_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([siswa_id])
}

// Catatan Sesi Konseling (Individu / Kelompok)
model KonselingSiswa {
  id                String         @id @default(uuid())
  tenant_id         String
  siswa_id          String
  tanggal           DateTime       @db.Date
  tipe              String         // INDIVIDU, KELOMPOK
  kelompok_id       String?        // Pengenal jika konseling kelompok dilakukan bersamaan
  masalah           String         @db.Text
  solusi            String?        @db.Text
  status            String         @default("PROSES") // PROSES, SELESAI
  petugas_id        String         // User ID guru BK yang menangani
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  Tenant            Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa             Siswa          @relation(fields: [siswa_id], references: [id])
  Petugas           User           @relation(fields: [petugas_id], references: [id])

  @@index([tenant_id])
  @@index([siswa_id])
}

// Catatan Pemanggilan Orang Tua
model PemanggilanOrangTua {
  id                  String       @id @default(uuid())
  tenant_id           String
  siswa_id            String
  tanggal_pemanggilan DateTime     @db.Date
  tanggal_pertemuan   DateTime?    @db.Date
  alasan              String       @db.Text
  keterangan_pertemuan String?     @db.Text
  status              String       @default("BARU") // BARU, DIKIRIM, HADIR, TIDAK_HADIR
  surat_dokumen_id    String?      // Relasi opsional ke file scan surat panggilan fisik
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  Tenant              Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa               Siswa        @relation(fields: [siswa_id], references: [id])
  Dokumen             SiswaDocument? @relation(fields: [surat_dokumen_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([siswa_id])
}

// Catatan Kunjungan Rumah (Home Visit)
model HomeVisit {
  id               String          @id @default(uuid())
  tenant_id        String
  siswa_id         String
  tanggal          DateTime        @db.Date
  alasan           String          @db.Text
  hasil            String?         @db.Text
  foto_dokumen_id  String?         // Relasi opsional ke file scan/foto laporan kunjungan rumah
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  Tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa            Siswa           @relation(fields: [siswa_id], references: [id])
  Dokumen          SiswaDocument?  @relation(fields: [foto_dokumen_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([siswa_id])
}

// Asesmen Kognitif/Psikososial/Angket BK
model AsesmenSiswa {
  id               String          @id @default(uuid())
  tenant_id        String
  siswa_id         String
  tanggal          DateTime        @db.Date
  nama_asesmen     String          // Contoh: "Sosiometri", "Kuesioner Gaya Belajar", "Tes Depresi Beck"
  hasil_skor       String?
  keterangan       String?         @db.Text
  dokumen_id       String?         // Relasi ke SiswaDocument (file hasil tes)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  Tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa            Siswa           @relation(fields: [siswa_id], references: [id])
  Dokumen          SiswaDocument?  @relation(fields: [dokumen_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([siswa_id])
}

// Rujukan Kasus ke Pihak Eksternal
model RujukanKasus {
  id               String          @id @default(uuid())
  tenant_id        String
  siswa_id         String
  tanggal          DateTime        @db.Date
  rujukan_ke       String          // Contoh: "Psikolog Klinis", "Rumah Sakit", "Dinas Pendidikan", "Kepala Sekolah"
  alasan           String          @db.Text
  status           String          @default("DIUSULKAN") // DIUSULKAN, SELESAI
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  Tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  Siswa            Siswa           @relation(fields: [siswa_id], references: [id])

  @@index([tenant_id])
  @@index([siswa_id])
}
