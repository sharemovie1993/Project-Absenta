{
  "name": "absensi-multitenant-backend",
  "version": "1.0.2",
  "description": "Backend aplikasi absensi multitenant untuk sekolah",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node scripts/dev/pre-dev.js && cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node-dev --transpile-only --respawn --ignore-watch logs --require tsconfig-paths/register src/main.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=4096 node scripts/adhoc/prisma-generate-with-retry.js && cross-env NODE_OPTIONS=--max-old-space-size=4096 tsc && npx tsc-alias -p tsconfig.json",
    "postbuild": "node -e \"const fs=require('fs');const path=require('path');const src=path.join('src','modules','notification','templates');const dest=path.join('dist','modules','notification','templates');try{fs.mkdirSync(dest,{recursive:true});for(const f of fs.readdirSync(src)){fs.copyFileSync(path.join(src,f),path.join(dest,f));}console.log('Copied templates to dist');}catch(e){console.error('Copy templates failed:',e.message);process.exitCode=0;}\"",
    "start": "node --max-old-space-size=4096 dist/main.js",
    "start:stress": "node --max-old-space-size=4096 dist/main.js",
    "load:workers": "ts-node -r tsconfig-paths/register scripts/dev/load-workers.ts",
    "load:burst": "ts-node -r tsconfig-paths/register scripts/dev/load-workers.ts 200 5",
    "load:steady": "ts-node -r tsconfig-paths/register scripts/dev/steady-load.ts",
    "load:diag": "ts-node -r tsconfig-paths/register scripts/dev/diagnostic-load.ts",
    "migrate:walikelas-role": "ts-node -r tsconfig-paths/register src/scripts/migrate_walikelas_role_to_struktur.ts",
    "migrate:absen-siswa": "ts-node -r tsconfig-paths/register src/scripts/migrate_absen_siswa_snapshot.ts",
    "migrate:kesiswaan-capabilities": "ts-node -r tsconfig-paths/register src/scripts/migrate_kesiswaan_capabilities.ts",
    "seed:clean-policies": "ts-node -r tsconfig-paths/register prisma/clean-and-seed-permissions.ts",
    "prisma:generate": "node scripts/adhoc/auto-backup-schema.js && cross-env NODE_OPTIONS=--max-old-space-size=4096 node scripts/adhoc/prisma-generate-with-retry.js",
    "prisma:migrate": "node scripts/adhoc/auto-backup-schema.js && prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/adhoc/auto-backup-schema.js && prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset --force --skip-generate --skip-seed",
    "prisma:migrate:check": "node -e \"const { spawnSync } = require('child_process'); const url = process.env.SHADOW_DATABASE_URL; if (!url) { console.error('SHADOW_DATABASE_URL is required'); process.exit(1); } const result = spawnSync('npx', ['prisma','migrate','diff','--exit-code','--from-migrations','prisma/migrations','--to-schema-datamodel','prisma/schema.prisma','--shadow-database-url', url], { stdio: 'inherit' }); process.exit(typeof result.status === 'number' ? result.status : 1);\"",
    "prisma:studio": "prisma studio",
    "pretest": "npm run prisma:generate",
    "pretest:unit": "npm run prisma:generate",
    "pretest:integration": "npm run prisma:generate",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "worker": "cross-env NODE_OPTIONS=--max-old-space-size=4096 ts-node -r tsconfig-paths/register src/worker.ts",
    "seed": "npx prisma db seed",
    "seed:visual": "ts-node -r tsconfig-paths/register src/database/seeds/seed_visual_dummies.ts",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/performance/seed-simulator.ts",
    "load:test": "node scripts/load-test-cli.js"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgresql",
    "multitenant",
    "attendance"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.880.0",
    "@aws-sdk/s3-request-presigner": "^3.880.0",
    "@faker-js/faker": "^10.3.0",
    "@fastify/cors": "^8.4.0",
    "@fastify/formbody": "^6.0.1",
    "@fastify/jwt": "^7.2.4",
    "@fastify/multipart": "^8.2.0",
    "@fastify/rate-limit": "^8.1.1",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/redis": "^4.0.10",
    "@types/stripe": "^8.0.416",
    "@types/web-push": "^3.6.4",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "adm-zip": "^0.5.17",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.67.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^4.24.3",
    "fastify-raw-body": "^4.3.0",
    "firebase-admin": "^13.7.0",
    "googleapis": "^171.4.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.10",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pm2": "^5.3.0",
    "prisma": "^5.6.0",
    "puppeteer": "^24.33.1",
    "qrcode": "^1.5.4",
    "redis": "^5.9.0",
    "redis-memory-server": "^0.16.1",
    "socket.io": "^4.8.1",
    "stream-json": "^1.9.1",
    "stripe": "^19.1.0",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "overrides": {
    "ioredis": "^5.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fastify-jwt": "^0.4.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@types/stream-json": "^1.7.8",
    "@types/supertest": "^2.0.16",
    "babel-jest": "^29.7.0",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.2.2"
  }
}
