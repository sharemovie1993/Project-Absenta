 # =============================================================================
 # Core Runtime (env.common)
 # =============================================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
 
NODE_ID=windows-node-1
APP_VERSION=1.0.0
WORKER_VERSION=1.0.0
 
ENABLE_DEBUG_LOGS=false
DEV_ALLOW_LOCALHOST_LOGIN=false
 
 # Security
JWT_SECRET=your-super-secret-jwt-key-here
BACKUP_SIGNING_SECRET=secure-backup-signing-secret-example
 
 # =============================================================================
 # URLs & Public Settings (env.common)
 # =============================================================================
APP_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:3001
API_URL=http://localhost:3001
PUBLIC_INVOICE_BASE_URL=http://localhost:3001
PUBLIC_APP_SCHEME=http
PUBLIC_DOMAIN_BASE=localhost
MAIN_DOMAIN=absenta.id
TENANT_BASE_DOMAIN=localhost
FRONTEND_URL=http://localhost:5173
PUBLIC_WEBSITE_URL=http://localhost:5173
PUBLIC_LANDING_URL=
PUBLIC_SITE_URL=
 
 # CORS / Debug
CORS_DEBUG=false
ALLOWED_LAN_IP=127.0.0.1

# LISENSI
LICENSE_SERVER_URL=https://api.absenta.id
LICENSE_KEY=
EASY_TUNNEL_BASE_DOMAIN=absenta.id
 
 # =============================================================================
 # Database (env.database)
 # =============================================================================
DATABASE_URL=postgresql://postgres:123123123@10.10.10.250:5432/absensi
 
 # =============================================================================
 # Redis (env.redis)
 # =============================================================================
# REDIS_MODE options: single, sentinel, cluster, embedded
REDIS_MODE=embedded
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=
REDIS_CLUSTER_NODES=
CACHE_TTL_DEFAULT=300

 # =============================================================================
 # Email (env.email)
 # =============================================================================
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=School System <no-reply@school.com>
ALERT_EMAIL=119asepsuryadi@gmail.com
 
PAYMENT_CURRENCY=IDR
PAYMENT_EXPIRY_MINUTES=1440
PAYMENT_CALLBACK_URL=https://api.absenta.id/payment/callback
PAYMENT_RETURN_URL=https://api.absenta.id/payment/return
 
 # =============================================================================
 # Integrations & Services
 # =============================================================================
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_KEY=change-me
WHATSAPP_DEVICE_ID=
WHATSAPP_WEBHOOK_SECRET=
 
FACE_EMBEDDING_URL=https://api.absenta.id/api/embedding
FACE_EMBEDDING_MODE=internal
 
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service.json
 
 # =============================================================================
 # Invoice & Verification
 # =============================================================================
INVOICE_PUBLIC_LINK_TTL_SECONDS=604800
INVOICE_PUBLIC_LINK_TTL_INITIAL_SECONDS=604800
INVOICE_PDF_DOWNLOAD_WAIT_MS=
 
VERIFICATION_TOKEN_TTL_MINUTES=1440

# =============================================================================
# Storage (Multi-Node & On-Premise)
# =============================================================================
# STORAGE_DRIVER options: local, s3
STORAGE_DRIVER=local
# Directory path for local storage files in on-premise/local deployments. Defaults to app root directory.
STORAGE_LOCAL_DIR=
# Set to true to redirect clients directly to S3 URLs instead of streaming via backend API. Only applies when STORAGE_DRIVER=s3.
STORAGE_USE_DIRECT_URL=false

S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=3600
 
 # =============================================================================
 # Defaults & Policies (env.production)
 # =============================================================================
DEFAULT_GURU_PASSWORD=password1234
DEFAULT_SISWA_PASSWORD=password1234
ENABLE_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
MAINTENANCE_MODE=false
BILLING_CRON_ENABLED=true
DUE_DAYS=3
GRACE_PERIOD_DAYS=7
DEFAULT_TRIAL_END_BEHAVIOR=NEXT_BILLING_FROM_END
NOTIFICATIONS_ENABLED=true
 
 # =============================================================================
 # Logging
 # =============================================================================
LOG_FILE_PATH=logs/backend.log
