 # =============================================================================
 # Core Runtime (env.common)
 # =============================================================================
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
 
NODE_ID=windows-node-1
APP_VERSION=1.0.0
WORKER_VERSION=1.0.0
 
ENABLE_DEBUG_LOGS=false
DEV_ALLOW_LOCALHOST_LOGIN=false
 
 # Security
JWT_SECRET=your-super-secret-jwt-key-here
BACKUP_SIGNING_SECRET=secure-backup-signing-secret-example
 
 # =============================================================================
 # URLs & Public Settings (env.common)
 # =============================================================================
APP_URL=http://localhost:3001
PUBLIC_APP_URL=https://api.absenta.id
API_URL=http://localhost:3001
PUBLIC_INVOICE_BASE_URL=https://api.absenta.id
PUBLIC_APP_SCHEME=https
PUBLIC_DOMAIN_BASE=absenta.id
TENANT_BASE_DOMAIN=absenta.id
FRONTEND_URL=https://www.absenta.id
PUBLIC_WEBSITE_URL=https://www.absenta.id
PUBLIC_LANDING_URL=
PUBLIC_SITE_URL=
 
 # CORS / Debug
CORS_DEBUG=false
 
 # =============================================================================
 # Database (env.database)
 # =============================================================================
DATABASE_URL=postgresql://postgres:123123123@10.10.10.250:5432/absensi
 
 # =============================================================================
 # Redis (env.redis)
 # =============================================================================
REDIS_MODE=single
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_NAME=
REDIS_CLUSTER_NODES=
CACHE_TTL_DEFAULT=300
 
 # =============================================================================
 # Email (env.email)
 # =============================================================================
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=School System <no-reply@school.com>
ALERT_EMAIL=119asepsuryadi@gmail.com
 
 # =============================================================================
 # Payments (env.payment)
 # =============================================================================
 # Midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_URL=https://api.absenta.id/api/payments/midtrans/webhook
 
 # Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_WEBHOOK_URL=https://api.absenta.id/api/payments/stripe/webhook
 
 # Xendit
XENDIT_SECRET_KEY=xnd_development_your-xendit-secret-key
XENDIT_WEBHOOK_TOKEN=
XENDIT_WEBHOOK_URL=https://api.absenta.id/api/payments/xendit/webhook
 
 # Tripay
TRIPAY_API_KEY=DEV-xxxxxxxx
TRIPAY_PRIVATE_KEY=xxxxxxxx
TRIPAY_MERCHANT_CODE=T35062
TRIPAY_WEBHOOK_URL=https://api.absenta.id/webhooks/payment/tripay
TRIPAY_WEBHOOK_TOKEN=
 
 # Payment Config
PAYMENT_CURRENCY=IDR
PAYMENT_EXPIRY_MINUTES=1440
PAYMENT_CALLBACK_URL=https://api.absenta.id/payment/callback
PAYMENT_RETURN_URL=https://api.absenta.id/payment/return
 
 # =============================================================================
 # Integrations & Services
 # =============================================================================
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_KEY=change-me
WHATSAPP_DEVICE_ID=
WHATSAPP_WEBHOOK_SECRET=
 
FACE_EMBEDDING_URL=https://api.absenta.id/api/embedding
FACE_EMBEDDING_MODE=internal
 
FIREBASE_SERVICE_ACCOUNT_PATH=C:\path\to\firebase-service.json
 
 # =============================================================================
 # Invoice & Verification
 # =============================================================================
INVOICE_PUBLIC_LINK_TTL_SECONDS=604800
INVOICE_PUBLIC_LINK_TTL_INITIAL_SECONDS=604800
INVOICE_PDF_DOWNLOAD_WAIT_MS=
 
VERIFICATION_TOKEN_TTL_MINUTES=1440

# =============================================================================
# Storage (Multi-Node)
# =============================================================================
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
S3_PRESIGN_EXPIRES_SECONDS=3600
 
 # =============================================================================
 # Defaults & Policies (env.production)
 # =============================================================================
DEFAULT_GURU_PASSWORD=password1234
DEFAULT_SISWA_PASSWORD=password1234
ENABLE_PUBLIC_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
MAINTENANCE_MODE=false
BILLING_CRON_ENABLED=true
DUE_DAYS=3
GRACE_PERIOD_DAYS=7
DEFAULT_TRIAL_END_BEHAVIOR=NEXT_BILLING_FROM_END
NOTIFICATIONS_ENABLED=true
 
 # =============================================================================
 # Logging
 # =============================================================================
LOG_FILE_PATH=logs/backend.log
