# ==============================================================================
# 🚀 KONFIGURASI PRODUKSI (TEMPLATE)
# Salin file ini ke .env di server produksi Anda.
# ==============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=3001
NODE_ID=node-prod-1
APP_VERSION=1.0.0

# ==============================================================================
# 🌐 DOMAIN & URL (WAJIB DISESUAIKAN)
# ==============================================================================
# Ganti dengan domain utama Anda (tanpa https://)
MAIN_DOMAIN=absenta.id

# Alamat lengkap API (Gunakan HTTPS)
API_URL=https://api.absenta.id

# Alamat lengkap Dashboard Frontend
FRONTEND_URL=https://app.absenta.id

# ==============================================================================
# 🔐 KEAMANAN (GANTI DENGAN KODE ACAK PANJANG)
# ==============================================================================
JWT_SECRET=Masukan_Kode_Rahasia_Sangat_Panjang_Di_Sini_1234567890
STRESS_TEST_SECRET=Ganti_Secret_Key_Ini

# ==============================================================================
# 🐘 DATABASE PRODUKSI
# ==============================================================================
DATABASE_URL=postgresql://user:password@host_server_database:5432/nama_db_produksi

# ==============================================================================
# 📩 EMAIL SMTP (LOGS & NOTIFIKASI)
# ==============================================================================
EMAIL_HOST=smtp.nama-layanan.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=admin@absenta.id
EMAIL_PASS=password_email_anda
EMAIL_FROM="Absenta Official <no-reply@absenta.id>"

# ==============================================================================
# 📦 STORAGE CLOUD (S3 / MINIO)
# ==============================================================================
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.region.amazonaws.com
S3_BUCKET=nama-bucket-produksi
S3_ACCESS_KEY=access_key_anda
S3_SECRET_KEY=secret_key_anda
S3_PUBLIC_BASE_URL=https://link-publik-ke-storage.com/bucket-name
