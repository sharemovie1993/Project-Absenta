# ==============================================================================
# 🚀 KONFIGURASI PRODUKSI FRONTEND (TEMPLATE)
# Salin file ini ke .env di server produksi Anda.
# ==============================================================================

# Alamat lengkap API produksi Anda (Gunakan HTTPS)
VITE_API_BASE_URL=https://api.absenta.id/api

# DOMAIN INDUK (Wajib sama dengan MAIN_DOMAIN di Backend)
VITE_MAIN_DOMAIN=absenta.id

# Nama Aplikasi & Versi
VITE_APP_NAME="Absenta Professional"
VITE_APP_VERSION=1.0.0

# Email dukungan yang muncul di dashboard user
VITE_SUPPORT_EMAIL=support@absenta.id

# ==============================================================================
# 🛰️ REALTIME & SOCKET SETTINGS
# ==============================================================================
# Biarkan KOSONG agar otomatis mendeteksi alamat host produksi secara dinamis.
VITE_SOCKET_URL=

VITE_REALTIME_ENABLED_DEFAULT=true
VITE_REALTIME_MAX_RECONNECT_ATTEMPTS=10
VITE_REALTIME_RECONNECTION=true

# ==============================================================================
# 🛠️ INTERNAL SECRETS
# ==============================================================================
VITE_DEV_MODE=false
VITE_FRONTEND_FLAG=1
VITE_BACKEND_FLAG=1
